  "publicApiSurface": [
    "GET /documents — list documents in a collection",
    "POST /documents — create or upload a document",
    "GET /documents/{id} — retrieve a document",
    "PUT /documents/{id} — update a document",
    "DELETE /documents/{id} — delete a document",
    "GET /collections — list collections",
    "POST /collections — create a collection",
    "GET /permissions — list permissions for a resource",
    "PUT /permissions — update permissions for a resource",
    "POST /agents/token — generate an agent access token",
    "GET /agents/me — get agent identity and accessible resources"
  ]
